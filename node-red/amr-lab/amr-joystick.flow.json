  },
  {
    "id": "amr-joystick-request",
    "type": "http in",
    "z": "capstone-amr-joystick",
    "name": "เปิดหน้า Joystick",
    "url": "/amr/joystick",
    "method": "get",
    "upload": false,
    "x": 180,
    "y": 100,
    "wires": [
      [
        "amr-joystick-template"
      ]
    ]
  },
  {
    "id": "amr-joystick-template",
    "type": "template",
    "z": "capstone-amr-joystick",
    "name": "หน้า Joystick AMR จำลอง",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!doctype html>\n<html lang=\"th\">\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AMR Route Lab · ทดลอง Joystick</title>\n<style>\n  :root{color-scheme:dark;font:15px/1.5 \"Segoe UI\",Tahoma,sans-serif;background:#0d1622;color:#edf5fc;--muted:#aabfd1;--line:#2a4055;--surface:#142435;--mint:#7ce9cd}\n  *{box-sizing:border-box}\n  body{margin:0}\n  main{max-width:1350px;margin:auto;padding:clamp(14px,3vw,42px)}\n  h1,h2,p{margin:0}\n  h1{font-size:clamp(1.55rem,4vw,2.5rem);line-height:1.2}\n  h2{font-size:1.05rem}\n  header,.panel-head,.control-head,.status-row{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}\n  header{margin-bottom:20px}\n  .sub{margin-top:5px;color:var(--muted)}\n  .mode{padding:5px 10px;border:1px solid #4e695e;border-radius:6px;color:#b2eed9;background:#1b3434;font-size:.82rem}\n  .layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:start}\n  .panel{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}\n  .panel-head,.pane,.status-row{padding:13px 15px}\n  .pane+.pane,.status-row{border-top:1px solid var(--line)}\n  .status-row,.help{color:var(--muted);font-size:.87rem}\n  .help{margin-top:7px}\n  button{font:inherit;color:inherit;cursor:pointer;border:1px solid #3a5268;background:#1d3144;border-radius:8px;padding:7px 11px}\n  button:hover{background:#2a445a}\n  button:disabled{opacity:.48;cursor:default}\n  :focus-visible{outline:2px solid var(--mint);outline-offset:3px}\n  .primary{background:var(--mint);border-color:var(--mint);color:#102822;font-weight:700}\n  .primary:hover{background:#a9f5e1}\n  .robots{display:grid;gap:6px;margin-top:10px}\n  .robot{display:grid;grid-template-columns:10px 1fr auto;gap:8px;align-items:center;text-align:left}\n  .robot[aria-pressed=\"true\"]{border-color:var(--robot);background:#284253}\n  .swatch{width:8px;height:8px;border-radius:100%;background:var(--robot)}\n  .robot small{font-size:.78rem;color:var(--muted)}\n  #open-control{width:100%;margin-top:10px}\n  #map{display:block;width:100%;height:auto;background:#0e1928}\n  .map-marker{cursor:pointer}\n  .map-marker text{font-weight:700;fill:#f1f8ff;paint-order:stroke;stroke:#101a26;stroke-width:5px;pointer-events:none}\n  .map-marker:focus-visible .ring,.map-marker[aria-pressed=\"true\"] .ring{visibility:visible}\n  .ring{visibility:hidden}\n  #pad{position:relative;width:min(100%,184px);aspect-ratio:1;margin:14px auto 10px;border:1px solid #496279;border-radius:50%;background:radial-gradient(circle,#1c3547 14%,transparent 15%,transparent 40%,#182e40 41%),#122333;touch-action:none;user-select:none;cursor:grab}\n  #pad.active{cursor:grabbing;border-color:var(--mint)}\n  #pad::before,#pad::after{content:\"\";position:absolute;pointer-events:none;background:#486173}\n  #pad::before{left:15%;right:15%;top:50%;height:1px}\n  #pad::after{top:15%;bottom:15%;left:50%;width:1px}\n  #knob{position:absolute;z-index:1;left:50%;top:50%;width:32%;aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%);background:#7ce9cd;border:3px solid #b1f4e3;box-shadow:0 3px 8px #071e27;pointer-events:none}\n  .axis{position:absolute;color:#d8e6ef;font-size:1rem;pointer-events:none}\n  .up{top:3%;left:50%;translate:-50% 0}.down{bottom:3%;left:50%;translate:-50% 0}\n  .left{left:5%;top:50%;translate:0 -50%}.right{right:5%;top:50%;translate:0 -50%}\n  #control-state{min-height:1.5em;text-align:center;color:var(--mint);font-weight:600}\n  [hidden]{display:none!important}\n  @media(max-width:820px){.layout{grid-template-columns:1fr}.robots{grid-template-columns:repeat(3,minmax(0,1fr))}.robot{grid-template-columns:8px 1fr}.robot small{grid-column:2}}\n  @media(max-width:560px){\n    .layout{display:block}\n    .map-panel{position:sticky;top:0;z-index:2}\n    .map-panel .panel-head,.map-panel .status-row{padding:7px 10px}\n    .layout aside{margin-top:12px}\n    :is(.robot,#open-control,#close-control,#pad){scroll-margin-top:clamp(175px,56vw,290px)}\n  }\n  @media(max-width:400px){.robot{font-size:.86rem;padding:6px}.control-head h2{font-size:.92rem}}\n</style>\n<main>\n  <header>\n    <div><h1>ควบคุม AMR ด้วย Joystick</h1><p class=\"sub\">AMR Route Lab · ผังชั้น 9</p></div>\n    <span class=\"mode\">โหมดจำลอง</span>\n  </header>\n  <div class=\"layout\">\n    <section class=\"panel map-panel\" aria-labelledby=\"map-title\">\n      <div class=\"panel-head\"><h2 id=\"map-title\">ตำแหน่งรถบนผัง</h2></div>\n      <svg id=\"map\" viewBox=\"0 0 1196 583\" aria-label=\"ผังชั้น 9 พร้อมตำแหน่ง AMR สามคัน\">\n        <image href=\"data:image/png;base64,\" width=\"1196\" height=\"583\" opacity=\".86\"/>\n        <g id=\"markers\"></g>\n      </svg>\n      <div class=\"status-row\"><span id=\"map-hint\">เลือกคันจากหมุดบนผังหรือรายการรถ</span></div>\n    </section>\n    <aside class=\"panel\" aria-label=\"เลือกและควบคุมรถ\">\n      <section class=\"pane\" aria-labelledby=\"fleet-title\">\n        <h2 id=\"fleet-title\">เลือก AMR</h2>\n        <div class=\"robots\" id=\"robot-list\"></div>\n        <button id=\"open-control\" class=\"primary\" type=\"button\" aria-controls=\"control\" aria-expanded=\"false\" disabled>Joystick</button>\n      </section>\n      <section id=\"control\" class=\"pane\" aria-labelledby=\"control-title\" hidden>\n        <div class=\"control-head\">\n          <h2 id=\"control-title\">Joystick</h2>\n          <button id=\"close-control\" type=\"button\">ปิด</button>\n        </div>\n        <p id=\"pad-help\" class=\"help\">กดค้างแล้วดันขึ้นหรือลงเพื่อเดินหน้าและถอย ดันซ้ายหรือขวาเพื่อหมุน แล้วปล่อยเพื่อหยุด ใช้ปุ่มลูกศรได้เมื่อเลือกแป้น</p>\n        <div id=\"pad\" role=\"group\" tabindex=\"0\" aria-label=\"แป้นควบคุมทิศทาง\" aria-describedby=\"pad-help\">\n          <span class=\"axis up\" aria-hidden=\"true\">↑</span><span class=\"axis down\" aria-hidden=\"true\">↓</span>\n          <span class=\"axis left\" aria-hidden=\"true\">↶</span><span class=\"axis right\" aria-hidden=\"true\">↷</span>\n          <span id=\"knob\"></span>\n        </div>\n        <p id=\"control-state\" role=\"status\">พร้อมขยับในโหมดจำลอง</p>\n      </section>\n    </aside>\n  </div>\n</main>\n<script>\n  const robots = [\n    { id: 1, x: 190, y: 205, heading: 0, color: '#78ebc6' },\n    { id: 2, x: 345, y: 265, heading: Math.PI, color: '#ffd184' },\n    { id: 3, x: 235, y: 319, heading: -Math.PI / 2, color: '#91c9ff' },\n  ];\n  const svgNamespace = 'http://www.w3.org/2000/svg';\n  const robotList = document.querySelector('#robot-list');\n  const markers = document.querySelector('#markers');\n  const mapHint = document.querySelector('#map-hint');\n  const openControl = document.querySelector('#open-control');\n  const closeControl = document.querySelector('#close-control');\n  const panel = document.querySelector('#control');\n  const controlTitle = document.querySelector('#control-title');\n  const controlState = document.querySelector('#control-state');\n  const pad = document.querySelector('#pad');\n  const knob = document.querySelector('#knob');\n  const keys = new Set();\n  const arrowKeys = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);\n  let selected = null;\n  let controlled = null;\n  let pointerId = null;\n  let input = { turn: 0, drive: 0 };\n  let frame = null;\n  let lastFrame = null;\n\n  function moveMarker(robot) {\n    robot.marker.setAttribute('transform', 'translate(' + robot.x.toFixed(2) + ' ' + robot.y.toFixed(2) + ')');\n    robot.headingMarker.setAttribute('transform', 'rotate(' + (robot.heading * 180 / Math.PI).toFixed(2) + ')');\n  }\n\n  function selectRobot(robot) {\n    if (selected === robot) return;\n    closeJoystick();\n    selected = robot;\n    openControl.disabled = false;\n    renderMapHint();\n    for (const item of robots) {\n      const active = String(item === robot);\n      item.button.setAttribute('aria-pressed', active);\n      item.marker.setAttribute('aria-pressed', active);\n    }\n  }\n\n  function renderMapHint() {\n    mapHint.textContent = controlled ? 'แผง Joystick ผูกกับ AMR ' + controlled.id\n      : selected ? 'เลือก AMR ' + selected.id + ' แล้ว · กด Joystick เพื่อเปิดแผง'\n      : 'เลือกคันจากหมุดบนผังหรือรายการรถ';\n  }\n\n  for (const robot of robots) {\n    const label = 'AMR ' + robot.id;\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'robot';\n    button.style.setProperty('--robot', robot.color);\n    button.setAttribute('aria-pressed', 'false');\n    button.innerHTML = '<span class=\"swatch\"></span><strong>' + label + '</strong><small>พร้อม</small>';\n    button.addEventListener('click', () => selectRobot(robot));\n    robot.button = button;\n    robotList.append(button);\n\n    const marker = document.createElementNS(svgNamespace, 'g');\n    marker.setAttribute('class', 'map-marker');\n    marker.setAttribute('role', 'button');\n    marker.setAttribute('tabindex', '0');\n    marker.setAttribute('aria-label', 'เลือก ' + label + ' บนผัง');\n    marker.setAttribute('aria-pressed', 'false');\n    marker.setAttribute('color', robot.color);\n    marker.innerHTML = '<circle r=\"29\" fill=\"transparent\"/><circle class=\"ring\" r=\"23\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"/>'\n      + '<g><path d=\"M-12 -11H10L18 0L10 11H-12Z\" fill=\"currentColor\" stroke=\"#102233\" stroke-width=\"2\"/></g>'\n      + '<text x=\"0\" y=\"-30\" text-anchor=\"middle\" font-size=\"21\">' + label + '</text>';\n    marker.addEventListener('click', () => selectRobot(robot));\n    marker.addEventListener('keydown', event => {\n      if (event.key !== 'Enter' && event.key !== ' ') return;\n      event.preventDefault();\n      selectRobot(robot);\n    });\n    robot.marker = marker;\n    robot.headingMarker = marker.querySelector('g');\n    moveMarker(robot);\n    markers.append(marker);\n  }\n\n  function stopInput() {\n    const captured = pointerId;\n    pointerId = null;\n    keys.clear();\n    if (captured !== null && pad.hasPointerCapture(captured)) pad.releasePointerCapture(captured);\n    setInput(0, 0);\n  }\n\n  function closeJoystick() {\n    stopInput();\n    controlled = null;\n    panel.hidden = true;\n    openControl.setAttribute('aria-expanded', 'false');\n    renderMapHint();\n  }\n\n  openControl.addEventListener('click', () => {\n    if (!selected) return;\n    if (controlled) {\n      closeJoystick();\n      return;\n    }\n    controlled = selected;\n    controlTitle.textContent = 'Joystick · AMR ' + controlled.id;\n    panel.hidden = false;\n    openControl.setAttribute('aria-expanded', 'true');\n    renderMapHint();\n    pad.focus();\n  });\n  closeControl.addEventListener('click', () => {\n    closeJoystick();\n    openControl.focus();\n  });\n\n  function animate(now) {\n    frame = null;\n    if (!controlled || (!input.turn && !input.drive)) return;\n    const dt = lastFrame === null ? 0 : Math.min((now - lastFrame) / 1000, 0.05);\n    lastFrame = now;\n    const robot = controlled;\n    robot.heading = (robot.heading + input.turn * 2.1 * dt) % (2 * Math.PI);\n    robot.x = Math.max(24, Math.min(1172, robot.x + Math.cos(robot.heading) * input.drive * 112 * dt));\n    robot.y = Math.max(24, Math.min(559, robot.y + Math.sin(robot.heading) * input.drive * 112 * dt));\n    moveMarker(robot);\n    frame = requestAnimationFrame(animate);\n  }\n\n  function setInput(turn, drive) {\n    const moving = Boolean(controlled && (turn || drive));\n    input = { turn: moving ? turn : 0, drive: moving ? drive : 0 };\n    knob.style.left = 50 + input.turn * 30 + '%';\n    knob.style.top = 50 - input.drive * 30 + '%';\n    pad.classList.toggle('active', moving);\n    const status = moving ? 'กำลังขยับในโหมดจำลอง' : 'พร้อมขยับในโหมดจำลอง';\n    if (controlState.textContent !== status) controlState.textContent = status;\n    if (moving && frame === null) frame = requestAnimationFrame(animate);\n    if (!moving) {\n      if (frame !== null) cancelAnimationFrame(frame);\n      frame = null;\n      lastFrame = null;\n    }\n  }\n\n  function readPointer(event) {\n    const bounds = pad.getBoundingClientRect();\n    const turn = (event.clientX - bounds.left - bounds.width / 2) / (bounds.width * 0.3);\n    const drive = (bounds.top + bounds.height / 2 - event.clientY) / (bounds.height * 0.3);\n    const magnitude = Math.hypot(turn, drive);\n    const scale = Math.max(1, magnitude);\n    setInput(magnitude < 0.1 ? 0 : turn / scale, magnitude < 0.1 ? 0 : drive / scale);\n  }\n\n  pad.addEventListener('pointerdown', event => {\n    if (!controlled || pointerId !== null || event.button !== 0) return;\n    event.preventDefault();\n    pad.focus();\n    keys.clear();\n    pointerId = event.pointerId;\n    pad.setPointerCapture(pointerId);\n    readPointer(event);\n  });\n  pad.addEventListener('pointermove', event => {\n    if (event.pointerId === pointerId) readPointer(event);\n  });\n  for (const type of ['pointerup', 'pointercancel', 'lostpointercapture']) {\n    pad.addEventListener(type, event => {\n      if (event.pointerId === pointerId) stopInput();\n    });\n  }\n\n  function readKeys() {\n    const turn = Number(keys.has('ArrowRight')) - Number(keys.has('ArrowLeft'));\n    const drive = Number(keys.has('ArrowUp')) - Number(keys.has('ArrowDown'));\n    const scale = Math.max(1, Math.hypot(turn, drive));\n    setInput(turn / scale, drive / scale);\n  }\n\n  pad.addEventListener('keydown', event => {\n    if (event.key === 'Escape') {\n      closeJoystick();\n      openControl.focus();\n      return;\n    }\n    if (!controlled || pointerId !== null || !arrowKeys.has(event.key)) return;\n    event.preventDefault();\n    keys.add(event.key);\n    readKeys();\n  });\n  pad.addEventListener('keyup', event => {\n    if (!keys.delete(event.key)) return;\n    event.preventDefault();\n    readKeys();\n  });\n  pad.addEventListener('blur', stopInput);\n  window.addEventListener('blur', stopInput);\n  document.addEventListener('visibilitychange', () => {\n    if (document.hidden) stopInput();\n  });\n</script>\n</html>\n",
    "output": "str",
    "x": 430,
    "y": 100,
    "wires": [
      [
        "amr-joystick-response"
      ]
    ]
  },
  {
    "id": "amr-joystick-response",
    "type": "http response",
    "z": "capstone-amr-joystick",
